# Godot 4+ specific ignores
.godot/
/android/
/data/*.bak
/data/*.tmp

# Traducciones generadas por el importador de CSV: el runtime lee el .csv
# (scripts/idioma.gd), asi que no se versionan.
/locale/*.translation

# Binario exportado para el smoke (lo genera `--export-release`)
/build/

# Superpowers workspace (SDD/brainstorm sessions)
.superpowers/

